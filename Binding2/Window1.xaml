<Window x:Class="Binding2.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Binding2"
        mc:Ignorable="d"
        Title="Add Sun Task" Height="200" Width="250">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Width="auto" Text="Ведите название Подзадачи" Margin="0,10" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
        <TextBox Name="TBoxSTName" Grid.Row="1" Width="125" Text="" Margin="0,10" Height="25" FontSize="15"/>
        <TextBlock Grid.Row="1" Width="auto" Text="Название должно быть длинее 3 симолов" Margin="0" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
        <Button Grid.Row="2" Content="Add" Click="Button_Click" Width="75" Height="25" HorizontalAlignment="Center" VerticalAlignment="Top"/>
    </Grid>
</Window>
