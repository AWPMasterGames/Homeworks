<Window x:Class="Reg.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Reg"
        mc:Ignorable="d"
        Title="Registarion" Height="500" Width="450"
        MinHeight="200" MinWidth="200"
        MaxHeight="800" MaxWidth="800"
        SizeChanged="Window_SizeChanged"
        Name="RegWindow"
        >
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ButtonsStyles.xaml"/>
                <ResourceDictionary Source="/BackgroundStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
        

    <Grid>

        <ScrollViewer Name="RegistrationPanel" VerticalScrollBarVisibility="Hidden" Style="{StaticResource BackgroudStyle1}"
                      Visibility="Hidden">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="9*"/>
                    <ColumnDefinition Width="62*"/>
                    <ColumnDefinition Width="9*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="55*"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="55*"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="55*"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="55*"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="55*"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="55*"/>
                    <RowDefinition Height="37*"/>
                    <RowDefinition Height="37*"/>
                </Grid.RowDefinitions>
                <TextBox Style="{StaticResource BackgroudStyle2TBox}" Name="Username" Grid.Column="1" Grid.Row="2" TextWrapping="Wrap" Margin="0,0,0,0" Text="Username" FontSize="36"/>
                <TextBox Style="{StaticResource BackgroudStyle2TBox}" Name="Email" Grid.Column="1" Grid.Row="4" TextWrapping="Wrap" Margin="0,0,0,0" Text="E-mail" FontSize="36"/>
                <PasswordBox Style="{StaticResource BackgroudStyle2Pass}" Name="Password" Grid.Column="1" PasswordChanged="PasswordChanged" Grid.Row="6" Password="12345" Margin="0,0,0,0"  FontSize="36"/>
                <PasswordBox Style="{StaticResource BackgroudStyle2Pass}" Name="CPassword" Grid.Column="1" Grid.Row="8" Password="12345" Margin="0,0,0,0" FontSize="36"/>
                <DatePicker Background="Gray" Name="Birthday" Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="10" Width="310" FontSize="36"/>


                <TextBlock Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="0" TextWrapping="Wrap" Text="Register new user" VerticalAlignment="Center" Height="60" FontSize="36" RenderTransformOrigin="0.5,0.5" TextAlignment="Center" Width="310"/>
                <TextBlock Name="UsernameInfo" Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="1" TextWrapping="Wrap" Text="Username" VerticalAlignment="Center" Height="17" RenderTransformOrigin="0.5,0.5" Width="310"/>
                <TextBlock Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="3" TextWrapping="Wrap" Text="E-mail" VerticalAlignment="Center" Height="17" RenderTransformOrigin="0.5,0.5" Width="310"/>
                <TextBlock Name="PasswordInfo" Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="5" TextWrapping="Wrap" Text="Password" VerticalAlignment="Center" Height="17" RenderTransformOrigin="0.5,0.5" Width="310"/>
                <TextBlock Name="CPasswordInfo" Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="7" TextWrapping="Wrap" Text="Confirm password" VerticalAlignment="Center" Height="17" RenderTransformOrigin="0.5,0.5" Width="310"/>
                <TextBlock Name="DateInfoInfo" Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="9" TextWrapping="Wrap" Text="Birth date" VerticalAlignment="Center" Height="17" RenderTransformOrigin="0.5,0.5" Width="310"/>
                <Button Click="RegisterBtn" Style="{StaticResource YesButton}" Grid.Column="1" Content="Register" Margin="10,10,10,10" HorizontalAlignment="Center" Grid.Row="11" VerticalAlignment="Center" Width="268" Height="21"/>
                <Button Click="LoginPanelButton" Style="{StaticResource NeutralButton}" Grid.Column="1" Content="Login" Margin="10,10,10,10" HorizontalAlignment="Center" Grid.Row="12" VerticalAlignment="Center" Width="268" Height="21"/>

            </Grid>
        </ScrollViewer>
        <ScrollViewer Name="LoginPanel" VerticalScrollBarVisibility="Hidden" Style="{StaticResource BackgroudStyle1}"
                      Visibility="Visible">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="9*"/>
                    <ColumnDefinition Width="62*"/>
                    <ColumnDefinition Width="9*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="55*"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="55*"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="55*"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="55*"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="55*"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="55*"/>
                    <RowDefinition Height="37*"/>
                </Grid.RowDefinitions>
                <TextBox Style="{StaticResource BackgroudStyle2TBox}" Name="Login" Grid.Column="1" Grid.Row="2" TextWrapping="Wrap" Margin="0,0,0,0" Text="Username" FontSize="36"/>
                <PasswordBox  Style="{StaticResource BackgroudStyle2Pass}" Name="LPassword" Grid.Column="1" PasswordChanged="PasswordChanged" Grid.Row="4" Password="12345" Margin="0,0,0,0" FontSize="36"/>
                <Button Click="LoginBtn" Style="{StaticResource YesButton}" Grid.Column="1" Content="Login" Margin="0,00,00,00" HorizontalAlignment="Center" Grid.Row="6" VerticalAlignment="Center" Width="268" Height="36"/>


                <TextBlock Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="0" TextWrapping="Wrap" Text="Login" VerticalAlignment="Center" Height="60" FontSize="36" RenderTransformOrigin="0.5,0.5" TextAlignment="Center" Width="310"/>
                <TextBlock Name="UsernameInfo1" Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="1" TextWrapping="Wrap" Text="Username" VerticalAlignment="Center" Height="17" RenderTransformOrigin="0.5,0.5" Width="310"/>
                <TextBlock Name="PasswordInfo1" Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="3" TextWrapping="Wrap" Text="Password" VerticalAlignment="Center" Height="17" RenderTransformOrigin="0.5,0.5" Width="310"/>
                <TextBlock Name="LoginInfo" Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="5" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Height="17" RenderTransformOrigin="0.5,0.5" Width="310"/>
                <Button Click="RegPanelButton" Style="{StaticResource NeutralButton}" Grid.Column="1" Content="Registration" Margin="10,10,10,10" HorizontalAlignment="Center" Grid.Row="7" VerticalAlignment="Center" Width="268" Height="36"/>

            </Grid>
        </ScrollViewer>
        <ScrollViewer Name="Userpanel" Height="500" VerticalScrollBarVisibility="Hidden" Style="{StaticResource BackgroudStyle1}"
               Visibility="Hidden">
            <Grid Height="441">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="9*"/>
                    <ColumnDefinition Width="62*"/>
                    <ColumnDefinition Width="9*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="55*"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="55*"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="55*"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="55*"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="55*"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="55*"/>
                    <RowDefinition Height="37*"/>
                </Grid.RowDefinitions>

                <TextBlock Name="UserUsername" Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="2" TextWrapping="Wrap" Text="Username" VerticalAlignment="Center" Height="17" RenderTransformOrigin="0.5,0.5" Width="310"/>
                <TextBlock Name="UserEmail" Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="4" TextWrapping="Wrap" Text="Username" VerticalAlignment="Center" Height="17" RenderTransformOrigin="0.5,0.5" Width="310"/>
                <TextBlock Name="UserPassword" Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="6" TextWrapping="Wrap" Text="Username" VerticalAlignment="Center" Height="17" RenderTransformOrigin="0.5,0.5" Width="310"/>
                <TextBlock Name="UserBirthday" Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="8" TextWrapping="Wrap" Text="Username" VerticalAlignment="Center" Height="17" RenderTransformOrigin="0.5,0.5" Width="310"/>

                <TextBlock Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="0" TextWrapping="Wrap" Text="User Info" VerticalAlignment="Center" Height="60" FontSize="36" RenderTransformOrigin="0.5,0.5" TextAlignment="Center" Width="310"/>
                <TextBlock Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="1" TextWrapping="Wrap" Text="Username" VerticalAlignment="Center" Height="17" RenderTransformOrigin="0.5,0.5" Width="310"/>
                <TextBlock Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="3" TextWrapping="Wrap" Text="Email" VerticalAlignment="Center" Height="17" RenderTransformOrigin="0.5,0.5" Width="310"/>
                <TextBlock Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="5" TextWrapping="Wrap" Text="Password" VerticalAlignment="Center" Height="17" RenderTransformOrigin="0.5,0.5" Width="310"/>
                <TextBlock Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="7" TextWrapping="Wrap" Text="Birthday" VerticalAlignment="Center" Height="17" RenderTransformOrigin="0.5,0.5" Width="310"/>
                <Button Click="ExitBtn" Style="{StaticResource NoButton}" Grid.Column="1" Content="Exit" Margin="0,8,0,0" HorizontalAlignment="Center" Grid.Row="10" VerticalAlignment="Top" Width="268" Height="36"/>

            </Grid>
        </ScrollViewer>
    </Grid>



</Window>