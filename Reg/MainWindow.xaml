<Window x:Class="Reg.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Reg"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="450">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="9*"/>
            <ColumnDefinition Width="62*"/>
            <ColumnDefinition Width="9*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="55*"/>
            <RowDefinition Height="15*"/>
            <RowDefinition Height="55*"/>
            <RowDefinition Height="15*"/>
            <RowDefinition Height="55*"/>
            <RowDefinition Height="15*"/>
            <RowDefinition Height="55*"/>
            <RowDefinition Height="15*"/>
            <RowDefinition Height="55*"/>
            <RowDefinition Height="15*"/>
            <RowDefinition Height="55*"/>
            <RowDefinition Height="37*"/>
        </Grid.RowDefinitions>
        <TextBox Name="Username" Grid.Column="1" Grid.Row="2" TextWrapping="Wrap" Margin="0,0,0,0" Text="Username" Foreground="#FFB5B5B5" FontSize="36"/>
        <TextBox Name="Email" Grid.Column="1" Grid.Row="4" TextWrapping="Wrap" Margin="0,0,0,0" Text="E-mail" Foreground="#FFB5B5B5" FontSize="36"/>
        <PasswordBox Name="Password" Grid.Column="1" PasswordChanged="PasswordChanged" Grid.Row="6" Password="12345" Margin="0,0,0,0" Foreground="#FFB5B5B5" FontSize="36"/>
        <PasswordBox Name="CPassword" Grid.Column="1" Grid.Row="8" Password="12345" Margin="0,0,0,0" Foreground="#FFB5B5B5" FontSize="36"/>
        <DatePicker Name="Birthday" Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="10" Width="310" Foreground="#FFB5B5B5" FontSize="36"/>


        <TextBlock Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="0" TextWrapping="Wrap" Text="Register new user" VerticalAlignment="Center" Height="60" FontSize="36" RenderTransformOrigin="0.5,0.5" TextAlignment="Center" Width="310"/>
        <TextBlock Name="UsernameInfo" Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="1" TextWrapping="Wrap" Text="Username" VerticalAlignment="Center" Height="17" RenderTransformOrigin="0.5,0.5" Width="310"/>
        <TextBlock Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="3" TextWrapping="Wrap" Text="E-mail" VerticalAlignment="Center" Height="17" RenderTransformOrigin="0.5,0.5" Width="310"/>
        <TextBlock Name="PasswordInfo" Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="5" TextWrapping="Wrap" Text="Password" VerticalAlignment="Center" Height="17" RenderTransformOrigin="0.5,0.5" Width="310"/>
        <TextBlock Name="CPasswordInfo" Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="7" TextWrapping="Wrap" Text="Confirm password" VerticalAlignment="Center" Height="17" RenderTransformOrigin="0.5,0.5" Width="310"/>
        <TextBlock Name="DateInfoInfo" Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="9" TextWrapping="Wrap" Text="Birth date" VerticalAlignment="Center" Height="17" RenderTransformOrigin="0.5,0.5" Width="310"/>
        <Button Click="ConfirmBtn" Grid.Column="1" Content="Confirm" Margin="10,10,10,10" HorizontalAlignment="Center" Grid.Row="11" VerticalAlignment="Center" Width="268" Height="21"/>

    </Grid>



</Window>
