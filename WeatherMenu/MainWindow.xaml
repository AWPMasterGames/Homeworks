<Window x:Class="WeatherMenu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WeatherMenu"
        mc:Ignorable="d"
        Title="YandexWeather" Height="450" Width="800"
        >
    <Window.Resources>
        <ResourceDictionary Source="Icons.xaml" />
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,1" EndPoint="1,1">
                <GradientStop Color="HotPink" Offset="0.1"/>
                <GradientStop Color="LightCoral" Offset="0.5"/>
                <GradientStop Color="Orange" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="Synoptic diagnose"
                    Grid.Column="0" 
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="5,0"/>

            <TextBlock Text="Weather"
                       Grid.Column="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16"
                       FontWeight="Bold"/>

            <Button Content="Personal Desk"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="5,0"/>
        </Grid>

        <TextBlock Grid.Row="1"
                   Text="Weather Info for current period"
                   Margin="10,5"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   FontSize="14"
                   FontWeight="Bold"/>

        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Vertical"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="0,0,10,0">
                <Button Content="Home" Margin="0,0,0,5"/>
                <Button Content="Location" Margin="0,0,0,5"/>
                <Button Content="Settings" Margin="0,0,0,5"/>
                <Button Content="Close"/>
            </StackPanel>
            
            <Border Grid.Column="1" Margin="10,0" CornerRadius="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="White" Offset="0"/>
                        <GradientStop Color="AliceBlue" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Name="MainPanelInfoGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    
                    <Control Template="{StaticResource clear-day}" Grid.Column="1" Grid.RowSpan="2" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Row="0" FontSize="15" Text="{Binding WeekDay}" Name="TBlockCurrentDay" Width="auto" Margin="10,0,0,0"/>
                    <TextBlock Grid.Row="1" FontSize="20" Text="{Binding Location}" Name="TBCurentLocation" Width="auto" Margin="10,0,0,0"/>
                    <TextBlock Grid.Row="2" FontSize="30" Text="{Binding MaxTemperature}" Name="TBCurentTemperatureDay" Width="auto" Height="40"  Margin="10,0,0,0" HorizontalAlignment="Left" />
                    <TextBlock Grid.Row="2" Grid.Column="1" FontSize="15" Text="Night" Name="NightTextTB" Visibility="Hidden" Width="auto" Height="25" Margin="-15,-20,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" FontSize="15" Text="{Binding MinTemperature}" Name="TBCurentTemperatureNight" Width="auto" Height="25" Margin="-15,20,0,0"/>
                    <TextBlock Grid.Row="3" FontSize="15" Text="{Binding WeatherCodes}" Name="TBCurentWeatherType" Width="auto" Height="25"  Margin="15,0,0,0"/>
                    <Grid Grid.Row="4" Margin="10,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="15" Text="{Binding WindSpeed}" Name="TBWindSpeed" Width="auto" Height="25" Margin="5,0,0,0" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="1" FontSize="15" Text="ms" Name="WindMsTB" Width="auto" Visibility="Hidden" Height="25" Margin="5,0,0,0" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="3" FontSize="15" Text="{Binding Direction}" Width="auto" Height="25" Margin="5,0,0,0" HorizontalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="5" Margin="10,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" FontSize="15" Text="{Binding SurfasePressure}" Name="TBSurfasePressure" Width="auto" Height="25" Margin="5,0,0,0" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="2" FontSize="15" Text="mm" Name="SuppresTB" Width="auto" Visibility="Hidden" Height="25" Margin="5,0,0,0" HorizontalAlignment="Left"/>
                    </Grid>
                    <Grid Grid.Row="6" Margin="10,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" FontSize="15" Text="{Binding WindSpeed2}" Name="TBWindSpeed2" Width="auto" Height="25" Margin="5,0,0,0" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="2" FontSize="15" Text="mm hg" Name="WindMmTB" Width="auto" Visibility="Hidden" Height="25" Margin="5,0,0,0" HorizontalAlignment="Left"/>
                    </Grid>

                </Grid>
            </Border>

            <Border Grid.Column="2" Margin="10,0" CornerRadius="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="White" Offset="0"/>
                        <GradientStop Color="AliceBlue" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <ListBox x:Name="HeurlyForecastLB"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden" BorderBrush="#00000000"
                    >
                    
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5" Orientation="Horizontal">
                                <TextBlock Text="{Binding Time,StringFormat={}{0:hh:mm}}" FontSize="15" Margin="10,0,0,0"/>
                                <Control Template="{StaticResource clear-day}" />
                                <Grid Margin="5,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Temperature}" FontSize="15"/>
                                    <TextBlock Grid.Column="1" Text="°" FontSize="15" Foreground="#b5b5b5" VerticalAlignment="Bottom"/>
                                </Grid>
                                <Grid Margin="10,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ApparentTemperature}" FontSize="15"/>
                                    <TextBlock Grid.Column="1" Text="°" FontSize="15" Foreground="#b5b5b5" VerticalAlignment="Bottom"/>
                                </Grid>
                                <TextBlock Grid.Column="0" Text="{Binding SurfasePressure}" FontSize="15" Margin="10,0,0,0"/>
                                <TextBlock Grid.Column="0" Text="{Binding WindSpeed}" FontSize="15" Margin="10,0,0,0"/>
                                <TextBlock Grid.Column="0" Text="{Binding Direction}" FontSize="15" Margin="10,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
        <ListBox Width="400" x:Name="DaysOfWeek" SelectionChanged="DaysOfWeek_SelectionChanged"
                Grid.Row="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="10,10"
                ItemsSource="{Binding Days}"
                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                 ScrollViewer.IsDeferredScrollingEnabled="True"
                 Background="Transparent"
                 >
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="10" Width="75">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="AliceBlue" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="{Binding Date,StringFormat={}{0:M}}" FontSize="10" Margin="5,0,0,0"/>
                            <TextBlock Text="{Binding WeekDay}" FontWeight="Bold" FontSize="15" Margin="5,0,0,0"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding MaxTemperature}" FontSize="20" Margin="5,0,0,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding MinTemperature}" FontSize="12" Foreground="Gray" VerticalAlignment="Bottom" Margin="5,0,0,0"/>
                            </Grid>
                            <TextBlock Text="{Binding WeatherCodes}" FontSize="12" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </Grid>
</Window>
