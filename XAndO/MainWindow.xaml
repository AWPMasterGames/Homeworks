<Window x:Class="XAndO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XAndO"
        mc:Ignorable="d"
        Title="X And O" Height="500" Width="400"
        MinHeight="550" MinWidth="400"
        MaxHeight="1000" MaxWidth="800"
        Name="WindowXandO"
        >
    <Grid>
        <StackPanel Name="MainMenu" Visibility="Visible">
            <Grid Height="530">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="5*"/>


                </Grid.RowDefinitions>
                <Label Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="0" Content="Выберите режим игры" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" Height="97" FontSize="36" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                <Button Click="PvPMode" Content="Игрок против Игрока" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center" Height="76" Width="400" FontSize="36"/>
                <Button Name="PvEModS" Click="PvEMode" Content="Игрок против ПК" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center" Height="76" Width="400" FontSize="36"/>
                <Button  Content="ПК против ПК" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center" Height="76" Width="400" FontSize="36"/>
            </Grid>
        </StackPanel>

        <StackPanel Name="SetingGameMenu" Visibility="Hidden">
            <Grid Height="530">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="50*"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="50*"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="50*"/>


                </Grid.RowDefinitions>
                <Label Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="0" Content="Выберите настройки игры" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" Height="97" FontSize="30" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                <Label Name="LabelSymbolAsk" Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="1" Content="Выберите за кого играть" HorizontalAlignment="Left" VerticalAlignment="Center" Width="400" Height="38" FontSize="20" VerticalContentAlignment="Top" HorizontalContentAlignment="Center" />
                <RadioButton Name="SelecterX" Grid.Column="0" Grid.Row="2" Content="X" IsChecked="True" HorizontalAlignment="Left" Margin="72,0,0,0" VerticalAlignment="Center" Grid.ColumnSpan="2" Height="28" Width="44"/>
                <RadioButton Name="SelecterO" Grid.Column="2" Grid.Row="2" Content="O" IsChecked="False" HorizontalAlignment="Left" Margin="50,0,0,0" VerticalAlignment="Center" Height="28" Width="28"/>

                <Label Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="3" Content="Выберите сложноть игры" HorizontalAlignment="Left" VerticalAlignment="Center" Width="400" Height="36" FontSize="20" VerticalContentAlignment="Top" HorizontalContentAlignment="Center" />
                <Label Name="ViewDifficulty" Grid.Column="1" Content="Лёгкая" HorizontalAlignment="Center" Grid.Row="4" VerticalAlignment="Center" Grid.ColumnSpan="2" Width="200" Height="48" FontSize="30" HorizontalContentAlignment="Center"/>
                <Slider Name="DifficultySlider" Grid.ColumnSpan="2" HorizontalAlignment="Left" Minimum="1" Maximum="3" Margin="0,106,0,0" ValueChanged="DifficultyChange" Grid.Row="4" VerticalAlignment="Top" Width="200" Height="50" Grid.RowSpan="2" Grid.Column="1"/>
                <Button Grid.Column="1" Grid.ColumnSpan="2" Click="StartBtn" Content="Начать" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="7" VerticalAlignment="Top" Height="61" Width="200" FontSize="36"/>

            </Grid>
        </StackPanel>

        <StackPanel Name="GameMenu" Visibility="Hidden">
            <Grid Height="530">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="30*"/>
                    <RowDefinition Height="30*"/>
                    <RowDefinition Height="30*"/>


                </Grid.RowDefinitions>
                <Label Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="0" Content="" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" Height="97" FontSize="36" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                <TextBlock Name="TurnSymbolSecond" HorizontalAlignment="Left" Margin="35,0,0,0" FontSize="40" TextWrapping="Wrap" Text="Ход: " VerticalAlignment="Center" Height="58" Width="190" Grid.ColumnSpan="3"/>
                <Label Name="TurnSymbol" Grid.Column="1" Margin="71,-6,0,0" Content="Некто" FontSize="60" HorizontalAlignment="Left" VerticalAlignment="Top" Height="80" Width="186" Grid.ColumnSpan="2"/>

                <Button Name="btn1" Click="Select1" Content="" HorizontalAlignment="Center" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Height="80" Width="113"/>
                <Button Name="btn2" Click="Select2" Content="" HorizontalAlignment="Center" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Height="80" Width="113"/>
                <Button Name="btn3" Click="Select3" Content="" HorizontalAlignment="Center" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Height="80" Width="113"/>

                <Button Name="btn4" Click="Select4" Content="" HorizontalAlignment="Center" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Height="80" Width="113"/>
                <Button Name="btn5" Click="Select5" Content="" HorizontalAlignment="Center" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Height="80" Width="113"/>
                <Button Name="btn6" Click="Select6" Content="" HorizontalAlignment="Center" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" Height="80" Width="113"/>

                <Button Name="btn7" Click="Select7" Content="" HorizontalAlignment="Center" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Height="80" Width="113"/>
                <Button Name="btn8" Click="Select8"  Content="" HorizontalAlignment="Center" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Height="80" Width="113"/>
                <Button Name="btn9" Click="Select9"  Content="" HorizontalAlignment="Center" Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" Height="80" Width="113"/>
                <Button Name="RestartBtn" Content="Restart" Click="StartBtn" HorizontalAlignment="Left" Margin="67,36,0,0" Grid.Row="1" VerticalAlignment="Top" Height="53" Width="113" Grid.ColumnSpan="2"/>
                <Button Name="MainMenuButton" Click="MainMenuBtn" Content="Main Menu" HorizontalAlignment="Left" Margin="97,36,0,0" Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Height="53" Width="113" Grid.ColumnSpan="2"/>

            </Grid>
        </StackPanel>
    </Grid>
</Window>
