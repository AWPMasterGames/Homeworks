<Window x:Class="kontr.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:kontr"
        xmlns:local1="clr-namespace:kontr.Constrols"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="./Styles/Backgrounds.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Style="{StaticResource Style1}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Button Click="Button_Click" Background="Transparent">
            <local1:Form1/>
        </Button>
        <Button Click="Button_Click_1" Grid.Column="1" Background="Transparent">
            <local1:Form2/>
        </Button>
        <Button Click="Button_Click" Grid.Column="2" Background="Transparent">
            <local1:Form1/>
        </Button>
        <Button Click="Button_Click_1" Grid.Row="1" Grid.Column="0" Background="Transparent">
            <local1:Form2/>
        </Button>
        <Button Click="Button_Click" Grid.Row="1" Grid.Column="1" Background="Transparent">
            <local1:Form1/>
        </Button>
        <Button Click="LoadSave" Grid.Row="2" Grid.Column="2" Width="200" Height="30" Content="Открыть последнее сохранение"/>
    </Grid>
</Window>
