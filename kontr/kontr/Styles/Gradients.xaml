<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <RadialGradientBrush x:Key="Gradien1" >
        <GradientStop Color="AliceBlue" Offset="0.1"/>
        <GradientStop Color="LightBlue" Offset="0.3"/>
        <GradientStop Color="Aqua" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="Gradient2" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="Yellow" Offset="0.1"/>
        <GradientStop Color="Orange" Offset="0.5"/>
        <GradientStop Color="DarkOrange" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="Gradient3" >
        <GradientStop Color="Green" Offset="0.1"/>
        <GradientStop Color="LimeGreen" Offset="0.3"/>
        <GradientStop Color="Lime" Offset="1"/>
    </RadialGradientBrush>
</ResourceDictionary>