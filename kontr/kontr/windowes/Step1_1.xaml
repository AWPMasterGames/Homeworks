<Window x:Class="kontr.windowes.Step1_1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:kontr.windowes"
        mc:Ignorable="d"
        Title="Форма1" Height="375" Width="800"
        Closing="Window_Closing">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Backgrounds.xaml"/>
                <ResourceDictionary Source="/Styles/TextBlockStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="MainGrid" Background="{StaticResource Gradient2}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="1.2*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="ЛИЧНАЯ ИНФОРМАЦИЯ" Style="{StaticResource Title}" Grid.ColumnSpan="2"/>
        <StackPanel Grid.Row="1">
            <Border BorderThickness="3" Width="100" Height="100" BorderBrush="Black" Grid.Row="0" CornerRadius="60" Padding="0"
HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Border Name="mask" Background="White" CornerRadius="60"/>
                    <StackPanel>
                        <StackPanel.OpacityMask>
                            <VisualBrush Visual="{Binding ElementName=mask}"/>
                        </StackPanel.OpacityMask>
                        <Image x:Name="UserPhoto" />
                    </StackPanel>
                </Grid>
            </Border>
            <Button Content="Загрузить" Width="100" Margin="10" Click="Button_Click_1"/>
        </StackPanel>
        <Grid Grid.Row="1" Grid.Column=" 1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="Фамилия Имя Отчество" Style="{StaticResource Title}" VerticalAlignment="Bottom"/>
            <TextBox Text="{Binding Name}" Grid.Row="1" FontSize="30" Height="50"/>
        </Grid>
        <Grid Grid.Row="2" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="Элиектронная почта:" Style="{StaticResource Title}" Grid.Row="0" FontSize="20" Margin="5,5,5,5" Grid.ColumnSpan="2"/>
            <TextBlock Text="Номер телефона:" Style="{StaticResource Title}" Grid.Row="1" FontSize="20" Margin="5,5,5,5" Grid.ColumnSpan="2"/>
            <TextBlock Text="Дата рождения:" Style="{StaticResource Title}" Grid.Row="2" FontSize="20" Margin="5,5,5,5" Grid.ColumnSpan="2"/>

            <TextBox Grid.Row="0" Text="{Binding Email}" Grid.Column="2" FontSize="20" Margin="5,5,5,5"/>
            <TextBox Grid.Row="1" Text="{Binding Phone}" Grid.Column="2" FontSize="20" Margin="5,5,5,5"/>
            <TextBox Grid.Row="2" Text="{Binding DateOfBirth}" Grid.Column="2" FontSize="20" Margin="5,5,5,5"/>
        </Grid>
        <Button Grid.Row="3" Width="100" Height="25" Content="Вернуться" Click="Button_Click"/>
        <Button Grid.Row="3" Grid.Column="1" Width="100" Height="25" Content="Далее" Click="Button_Click_2"/>
    </Grid>
</Window>
